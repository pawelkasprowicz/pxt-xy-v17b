{"entries":[{"timestamp":1794479223059,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":486,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":1,"length1":322,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":207,"length1":41,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":234,"length1":31,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"xyv17b.ts","value":"\n/**\n * Sterowanie odtwarzaczem MP3 XY-V17B przez UART.\n */\n//% color=#1976D2 icon=\"\\uf001\" block=\"XY-V17B MP3\"\nnamespace xyv17b {\n    let initialized = false\n    let currentTrack = 0\n    let volume = 15\n    let looping = false\n    let playing = false\n    let seenPlaying = false\n    let finished = false\n    let waitingForStart = false\n    let paused = false\n    let rxBuffer = pins.createBuffer(0)\n    let lastQuery = 0\n    let lastStart = 0\n    let lastStatus = -1\n\n    function sendCommand(command: number, data: number[]) {\n        if (!initialized) return\n\n        let frame = pins.createBuffer(data.length + 4)\n        let sum = 0xAA + command + data.length\n\n        frame[0] = 0xAA\n        frame[1] = command\n        frame[2] = data.length\n\n        for (let i = 0; i < data.length; i++) {\n            frame[i + 3] = data[i]\n            sum += data[i]\n        }\n\n        frame[frame.length - 1] = sum & 0xFF\n        serial.writeBuffer(frame)\n    }\n\n    function startTrack(track: number) {\n        if (track < 1 || track > 65535) return\n\n        currentTrack = track\n        playing = false\n        seenPlaying = false\n        finished = false\n        paused = false\n        waitingForStart = true\n        lastStart = input.runningTime()\n\n        sendCommand(0x07, [\n            Math.idiv(track, 256),\n            track % 256\n        ])\n    }\n\n    function handleStatus(status: number) {\n        lastStatus = status\n\n        if (status == 1) {\n            playing = true\n            paused = false\n            seenPlaying = true\n            waitingForStart = false\n            finished = false\n        } else if (status == 2) {\n            playing = false\n            paused = true\n        } else if (status == 0) {\n            playing = false\n            paused = false\n\n            if (seenPlaying && currentTrack > 0) {\n                seenPlaying = false\n\n                if (looping) {\n                    startTrack(currentTrack)\n                } else {\n                    finished = true\n                    currentTrack = 0\n                }\n            }\n        }\n    }\n\n    function readResponses() {\n        let incoming = serial.readBuffer(0)\n\n        if (incoming.length > 0) {\n            let combined = pins.createBuffer(\n                rxBuffer.length + incoming.length\n            )\n\n            for (let i = 0; i < rxBuffer.length; i++) {\n                combined[i] = rxBuffer[i]\n            }\n\n            for (let i = 0; i < incoming.length; i++) {\n                combined[rxBuffer.length + i] = incoming[i]\n            }\n\n            rxBuffer = combined\n        }\n\n        while (rxBuffer.length >= 4) {\n            if (rxBuffer[0] != 0xAA) {\n                rxBuffer = rxBuffer.slice(1)\n                continue\n            }\n\n            let length = rxBuffer[2]\n            let frameSize = length + 4\n\n            if (length > 16) {\n                rxBuffer = rxBuffer.slice(1)\n                continue\n            }\n\n            if (rxBuffer.length < frameSize) break\n\n            let sum = 0\n\n            for (let i = 0; i < frameSize - 1; i++) {\n                sum += rxBuffer[i]\n            }\n\n            if ((sum & 0xFF) == rxBuffer[frameSize - 1]) {\n                if (rxBuffer[1] == 0x01 && length == 1) {\n                    handleStatus(rxBuffer[3])\n                }\n\n                rxBuffer = rxBuffer.slice(frameSize)\n            } else {\n                rxBuffer = rxBuffer.slice(1)\n            }\n        }\n    }\n\n    /**\n     * Uruchom komunikacje UART z XY-V17B.\n     */\n    //% block=\"inicjalizuj XY-V17B TX %tx RX %rx\"\n    //% tx.defl=SerialPin.P13\n    //% rx.defl=SerialPin.P15\n    //% weight=100\n    export function init(tx: SerialPin, rx: SerialPin): void {\n        if (initialized) return\n\n        serial.redirect(tx, rx, BaudRate.BaudRate9600)\n\n        initialized = true\n        rxBuffer = pins.createBuffer(0)\n        lastQuery = input.runningTime()\n\n        control.inBackground(function () {\n            while (true) {\n                if (initialized) {\n                    readResponses()\n\n                    if (input.runningTime() - lastQuery >= 200) {\n                        sendCommand(0x01, [])\n                        lastQuery = input.runningTime()\n                    }\n                }\n\n                basic.pause(20)\n            }\n        })\n    }\n\n    /**\n     * Odtworz plik MP3 o podanym numerze.\n     */\n    //% block=\"odtworz utwor %track\"\n    //% track.min=1 track.max=65535 track.defl=1\n    //% weight=90\n    export function play(track: number): void {\n        if (!initialized) return\n        startTrack(track)\n    }\n\n    /**\n     * Zatrzymaj odtwarzanie.\n     */\n    //% block=\"zatrzymaj odtwarzanie\"\n    //% weight=80\n    export function stop(): void {\n        if (!initialized) return\n\n        looping = false\n        playing = false\n        paused = false\n        seenPlaying = false\n        waitingForStart = false\n        finished = false\n        currentTrack = 0\n\n        sendCommand(0x04, [])\n    }\n\n    /**\n     * Wstrzymaj odtwarzanie.\n     */\n    //% block=\"pauza\"\n    //% weight=70\n    export function pause(): void {\n        if (!initialized) return\n        sendCommand(0x03, [])\n    }\n\n    /**\n     * Ustaw glosnosc od 0 do 30.\n     */\n    //% block=\"ustaw glosnosc %level\"\n    //% level.min=0 level.max=30 level.defl=15\n    //% weight=60\n    export function setVolume(level: number): void {\n        if (!initialized) return\n\n        level = Math.max(0, Math.min(30, level))\n        volume = level\n\n        sendCommand(0x13, [level])\n    }\n\n    /**\n     * Odczytaj ustawiony poziom glosnosci.\n     */\n    //% block=\"glosnosc\"\n    //% weight=55\n    export function getVolume(): number {\n        return volume\n    }\n\n    /**\n     * Wlacz lub wylacz automatyczne zapetlenie.\n     */\n    //% block=\"zapetlenie %enabled\"\n    //% weight=50\n    export function setLoop(enabled: boolean): void {\n        looping = enabled\n    }\n\n    /**\n     * Czy modul aktualnie odtwarza utwor?\n     */\n    //% block=\"czy odtwarza\"\n    //% weight=40\n    export function isPlaying(): boolean {\n        return playing\n    }\n\n    /**\n     * Czy utwor zakonczyl sie naturalnie?\n     */\n    //% block=\"czy zakonczono utwor\"\n    //% weight=30\n    export function isFinished(): boolean {\n        return finished\n    }\n\n    /**\n     * Ostatni status odebrany z modulu.\n     * 0 = STOP, 1 = GRA, 2 = PAUZA.\n     */\n    //% block=\"status odtwarzacza\"\n    //% weight=20\n    export function getStatus(): number {\n        return lastStatus\n    }\n}\n"}]},{"timestamp":1794479529784,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":3395,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block><block type=\"device_forever\" x=\"237\" y=\"0\"></block><block type=\"xyv17b_play\" disabled-reasons=\"pxt_automatic_disabled\" x=\"547\" y=\"204\"><value name=\"track\"><shadow type=\"math_number_minmax\" disabled-reasons=\"pxt_automatic_disabled\"><mutation min=\"1\" max=\"65535\" label=\"Track\" precision=\"0\"></mutation><field name=\"SLIDER\">1</field></shadow></value></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":0,"diffs":[[1,"\nxyv17b.init(SerialPin.P13, SerialPin.P15)\nxyv17b.setVolume(15)\nxyv17b.setLoop(true)\n\n"]]},{"start1":132,"length1":59,"diffs":[[1,"    xyv17b.play(1)\n"]]},{"start1":154,"length1":0,"diffs":[[1,"\ninput.onButtonPressed(Button.B, function () {\n    xyv17b.play(2)\n})\n\n"]]},{"start1":292,"length1":186,"diffs":[[1,"\n"]]},{"start1":323,"length1":27,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":255,"length1":35,"diffs":[[1,"    \"preferredEditor\": \"tsprj\"\n"]]}]}]},{"timestamp":1794480093536,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":3308,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"=]K*.${xG%m~DZ!#sFT@\">utwor</variable><variable id=\"9^R%1=U7,J9W#2S:[+Cs\">glosnosc</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"xyv17b_init\"><field name=\"tx\">SerialPin.P13</field><field name=\"rx\">SerialPin.P15</field><next><block type=\"xyv17b_setVolume\"><value name=\"level\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"30\" label=\"Level\" precision=\"0\"></mutation><field name=\"SLIDER\">10</field></shadow></value><next><block type=\"xyv17b_setLoop\"><value name=\"enabled\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow></value><next><block type=\"basic_show_icon\"><field name=\"i\">IconNames.Yes</field><next><block type=\"variables_set\"><field name=\"VAR\" id=\"=]K*.${xG%m~DZ!#sFT@\">utwor</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"9^R%1=U7,J9W#2S:[+Cs\">glosnosc</field